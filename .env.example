# ===========================================
# ThreadGuard AI — Environment Variables
# Copy this file to ".env" and fill your real values
# ===========================================

# ---- Anthropic (fallback / default AI provider) ----
# Get free credits at https://platform.claude.com (Settings -> API Keys -> Create Key)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# ---- Twilio (real WhatsApp connection) ----
# Get free from https://www.twilio.com/try-twilio (Console Dashboard -> Account Info)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ---- SAP AI Core (optional — if filled, AI calls route through SAP first) ----
# Get these from your SAP AI Core service key (SAP BTP trial -> AI Core instance)
# Leave blank to use Anthropic directly (demo still works fully without these)
SAP_AI_CORE_AUTH_URL=
SAP_AI_CORE_CLIENT_ID=
SAP_AI_CORE_CLIENT_SECRET=
SAP_AI_CORE_DEPLOYMENT_URL=
SAP_AI_CORE_RESOURCE_GROUP=default
SAP_AI_CORE_MODEL_NAME=claude-sonnet-4-6

# Port for local server
PORT=4000
